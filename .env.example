DATABASE_URL="postgresql://usuario:senha@localhost:5433/dungeons_fitness"
JWT_SECRET="troque_por_um_segredo_forte_aqui_minimo_16_chars"
JWT_EXPIRES_IN="7d"
PORT=3333
NODE_ENV="development"
# Timezone pra cálculo de "dia" (streaks, jobs de reset/expiração). Sem timezone por
# usuário ainda, então fixo pra todos — troque se a base de usuários for outro fuso.
APP_TIMEZONE="America/Sao_Paulo"
# Conta usada para enviar o e-mail com o código de redefinição de senha.
# EMAIL_PASS é uma "senha de app" gerada em https://myaccount.google.com/apppasswords
# (precisa de verificação em duas etapas ativada na conta do Gmail).
EMAIL_USER="contatodungeonandfitness@gmail.com"
EMAIL_PASS="troque_pela_senha_de_app_do_gmail"
